# AGID secrets template — copy to `.env` (gitignored) and fill in.
# The backend auto-loads `.env` at startup (interface/backend/config.py:_load_dotenv).
# Real shell env vars / secrets-manager values OVERRIDE this file.

# SOTA image-generator API keys (for the "SOTA vs Detectors" demo). Each is optional;
# a generator is greyed-out in the UI if its key is unset.
GEMINI_API_KEY=        # Nano Banana (Gemini 2.5 Flash Image)  -> aistudio.google.com/apikey
OPENAI_API_KEY=        # GPT Image (gpt-image-1)                -> platform.openai.com/api-keys
XAI_API_KEY=           # Grok (grok-2-image)                    -> console.x.ai
FAL_KEY=               # FLUX img2img via fal.ai                -> fal.ai/dashboard/keys

# Optional path overrides (defaults assume the cn023 node layout)
# AGID_CKPT_DIR=/hddstore/ssalehi/AGID/checkpoints
